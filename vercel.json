{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {"src": "api/index.mjs", "use": "@vercel/node", "config": {"includeFiles": ["public/**", "storage.mjs"]}},
    {"src": "public/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.mjs"},
    {"src": "/", "dest": "/public/index.html"},
    {"src": "/(app.js|style.css)", "dest": "/public/$1"}
  ]
}
